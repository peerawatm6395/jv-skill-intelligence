# ============================================================
# JV Skill Intelligence — Environment Variables Template
#
# Copy this file to .env.local for local development (gitignored),
# and set the same variables in Vercel Project Settings for
# staging/production. NEVER commit a file containing real values.
# ============================================================

# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key — SERVER-ONLY. Used exclusively by lib/calc-engine/**
# and lib/import/** (the KPI engine and Excel import pipeline), which by
# design must operate across all employees to compute peer benchmarks and
# promote staged data. Never expose this to the browser, never prefix it
# with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: enables the AI Workforce Assistant (/assistant, /api/ai/ask).
# Without this set, the rest of the app works normally and the assistant
# endpoint returns a clear "not configured" message instead of erroring.
ANTHROPIC_API_KEY=
